# Arcjet — get your key at https://app.arcjet.com (site: "Factory OPS")
ARCJET_KEY=ajkey_your_key_here

PORT=3000

# Prisma Postgres connection string
DATABASE_URL="postgres://user:password@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_to_a_long_random_string
# Public URL of this API (used for auth callbacks and cookies)
BETTER_AUTH_URL=http://localhost:3000
# Next.js frontend origin (CORS + trusted origin for auth requests)
FRONTEND_URL=http://localhost:3001
