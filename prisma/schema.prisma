generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Placeholder model only, to prove the Prisma <-> Postgres connection end to end.
// Replace with the real domain schema (Organization, Employee, Role, Item, Stock, etc.)
// during schema design.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}
