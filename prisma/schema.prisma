generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Placeholder model only, to prove the Prisma <-> Postgres connection end to end.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

// =============================================================================
// Auth (Better Auth core + admin plugin + organization plugin)
// Field names follow what Better Auth expects. Platform administrators are
// users with role = "admin" (admin plugin). Organization admins are members
// with role = "owner" | "admin" (organization plugin). Everyone else is a
// member whose fine grained access comes from a custom Role (see below).
// =============================================================================

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  phoneNumber   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // admin plugin
  role       String?   @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]

  auditLogs            AuditLog[]
  stockMovements       StockMovement[]
  ordersCreated        Order[]              @relation("OrderCreatedBy")
  productionsCreated   Production[]         @relation("ProductionCreatedBy")
  ticketsReported      Ticket[]             @relation("TicketReportedBy")
  ticketsAssigned      Ticket[]             @relation("TicketAssignedTo")
  ticketsAbout         Ticket[]             @relation("TicketSubjectUser")
  maintenancePerformed MachineMaintenance[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // admin plugin
  impersonatedBy       String?
  // organization plugin
  activeOrganizationId String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// A factory (tenant). Every domain row below is scoped by organizationId.
model Organization {
  id          String   @id
  name        String
  slug        String   @unique
  logo        String?
  description String?
  metadata    String?
  createdAt   DateTime @default(now())

  members     Member[]
  invitations Invitation[]
  roles       Role[]

  warehouses     Warehouse[]
  items          Item[]
  stocks         Stock[]
  stockBatches   StockBatch[]
  stockMovements StockMovement[]
  machines       Machine[]
  maintenances   MachineMaintenance[]
  tickets        Ticket[]
  orders         Order[]
  productions    Production[]
  auditLogs      AuditLog[]

  @@map("organization")
}

// An employee: a user's membership in one organization.
model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Better Auth built in role: "owner" | "admin" | "member".
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  // Custom role assigned by the organization admin (BREAD permissions).
  roleId     String?
  customRole Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  jobTitle   String?
  department String?
  hiredAt    DateTime?

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// =============================================================================
// Roles and permissions
// Permissions are a global catalogue (seeded): one row per resource x action.
// Each organization defines its own roles and picks permissions for them.
// =============================================================================

enum PermissionResource {
  EMPLOYEES
  ROLES
  WAREHOUSES
  ITEMS
  INVENTORY
  MACHINES
  TICKETS
  ORDERS
  PRODUCTION
  REPORTS
  AUDIT_LOGS
}

// BREAD: Browse, Read, Edit, Add, Delete
enum PermissionAction {
  BROWSE
  READ
  EDIT
  ADD
  DELETE
}

model Permission {
  id          String             @id @default(cuid())
  resource    PermissionResource
  action      PermissionAction
  name        String             @unique // e.g. "inventory:edit"
  description String?

  roles RolePermission[]

  @@unique([resource, action])
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  permissions RolePermission[]
  members     Member[]

  @@unique([organizationId, name])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// =============================================================================
// Items and inventory
// Stock is the current quantity of an item in a warehouse (fast reads).
// StockBatch splits that quantity by lot, carrying expiry dates for warnings.
// StockMovement is the append only ledger behind every quantity change, used
// for history and analytics.
// =============================================================================

enum ItemType {
  RAW_MATERIAL
  WORK_IN_PROGRESS
  FINISHED_GOOD
  CONSUMABLE
  SPARE_PART
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  PRODUCTION_IN
  PRODUCTION_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  EXPIRED
}

model Warehouse {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  location       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stocks      Stock[]
  batches     StockBatch[]
  movements   StockMovement[]
  productions Production[]

  @@unique([organizationId, name])
}

model Item {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku               String
  barcode           String?
  name              String
  description       String?
  type              ItemType     @default(RAW_MATERIAL)
  unit              String       @default("pcs") // pcs, kg, l, m ...
  costPrice         Decimal?     @db.Decimal(14, 2)
  salePrice         Decimal?     @db.Decimal(14, 2)
  reorderLevel      Decimal?     @db.Decimal(14, 3)
  // Warn this many days before a batch expires. Null = item does not expire.
  expiryWarningDays Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  stocks           Stock[]
  batches          StockBatch[]
  movements        StockMovement[]
  orderItems       OrderItem[]
  productions      Production[]
  productionInputs ProductionInput[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, name])
}

model Stock {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity       Decimal      @default(0) @db.Decimal(14, 3)
  updatedAt      DateTime     @updatedAt

  @@unique([itemId, warehouseId])
  @@index([organizationId])
  @@index([warehouseId])
}

model StockBatch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  batchNumber    String?
  quantity       Decimal      @db.Decimal(14, 3)
  unitCost       Decimal?     @db.Decimal(14, 2)
  manufacturedAt DateTime?
  expiryDate     DateTime?
  receivedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  movements StockMovement[]

  @@index([organizationId, expiryDate])
  @@index([itemId, warehouseId])
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           StockMovementType
  itemId         String
  item           Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  batchId        String?
  batch          StockBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  // Signed: positive adds stock, negative removes it.
  quantity       Decimal           @db.Decimal(14, 3)
  note           String?
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  productionId   String?
  production     Production?       @relation(fields: [productionId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([organizationId, createdAt])
  @@index([itemId, createdAt])
}

// =============================================================================
// Machines and tickets
// =============================================================================

enum MachineStatus {
  OPERATIONAL
  DOWN
  UNDER_MAINTENANCE
  RETIRED
}

enum TicketCategory {
  MACHINE
  EMPLOYEE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Machine {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  code              String? // internal asset tag / serial number
  description       String?
  location          String?
  status            MachineStatus @default(OPERATIONAL)
  purchasedAt       DateTime?
  lastMaintenanceAt DateTime?
  nextMaintenanceAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  maintenances MachineMaintenance[]
  tickets      Ticket[]
  productions  Production[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model MachineMaintenance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  machineId      String
  machine        Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  description    String
  cost           Decimal?     @db.Decimal(14, 2)
  performedAt    DateTime
  performedById  String?
  performedBy    User?        @relation(fields: [performedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([machineId, performedAt])
  @@index([organizationId])
}

model Ticket {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  category          TicketCategory
  status            TicketStatus   @default(OPEN)
  priority          TicketPriority @default(MEDIUM)
  // Set when category = MACHINE.
  machineId         String?
  machine           Machine?       @relation(fields: [machineId], references: [id], onDelete: SetNull)
  // Set when category = EMPLOYEE (the employee the problem is about).
  subjectUserId     String?
  subjectUser       User?          @relation("TicketSubjectUser", fields: [subjectUserId], references: [id], onDelete: SetNull)
  reportedById      String?
  reportedBy        User?          @relation("TicketReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedToId      String?
  assignedTo        User?          @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  // Downtime window, for machine availability analytics.
  downtimeStartedAt DateTime?
  downtimeEndedAt   DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([machineId])
}

// =============================================================================
// Orders and production
// Profit is not stored: it is derived from sale order lines (revenue) minus
// purchase costs / batch unit costs and production inputs.
// =============================================================================

enum OrderType {
  SALE
  PURCHASE
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

model Order {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           OrderType
  number         String // human readable, unique per organization
  status         OrderStatus  @default(DRAFT)
  // Customer for SALE, supplier for PURCHASE.
  counterparty   String
  orderDate      DateTime     @default(now())
  fulfilledAt    DateTime?
  totalAmount    Decimal      @default(0) @db.Decimal(14, 2)
  notes          String?
  createdById    String?
  createdBy      User?        @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items     OrderItem[]
  movements StockMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, type, orderDate])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(14, 2)

  @@index([orderId])
  @@index([itemId])
}

model Production {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // The item produced.
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity       Decimal      @db.Decimal(14, 3)
  // Where the output is stored.
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  machineId      String?
  machine        Machine?     @relation(fields: [machineId], references: [id], onDelete: SetNull)
  description    String?
  producedAt     DateTime     @default(now())
  createdById    String?
  createdBy      User?        @relation("ProductionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inputs    ProductionInput[]
  movements StockMovement[]

  @@index([organizationId, producedAt])
  @@index([itemId])
}

// Raw materials consumed by a production run.
model ProductionInput {
  id           String     @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity     Decimal    @db.Decimal(14, 3)

  @@index([productionId])
  @@index([itemId])
}

// =============================================================================
// Audit log
// =============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  OTHER
}

model AuditLog {
  id                String        @id @default(cuid())
  // Null for platform level actions (e.g. an administrator creating an org).
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId          String?
  author            User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  action            AuditAction
  entityType        String // e.g. "Item", "Role"
  entityId          String?
  changeDescription String
  before            Json?
  after             Json?
  createdAt         DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}
